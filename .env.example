# Backend
APP_ENV=development
APP_VERSION=0.1.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGIN=http://localhost:5173

# IBM watsonx.ai — Phase 2+, leave blank for Phase 1
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
