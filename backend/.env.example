# CollisionGuard AI -- environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Backend
APP_ENV=development
APP_VERSION=0.1.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGIN=http://localhost:5173

# IBM watsonx.ai (Phase 6+)
# Leave all blank for Phase 1-5 operation (deterministic fallback is used).
# URL must be HTTPS, e.g. https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
# Override to use a specific Granite model. Default: ibm/granite-3-8b-instruct
WATSONX_MODEL_ID=
